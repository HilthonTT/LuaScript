--!nocheck
-- Clustering native module: unsupervised grouping of numeric points.
-- A "point" is an array of numbers; "data" is an array of points.
local clustering = require("clustering")

print("=== Clustering Module ===")
print("VERSION:", clustering.VERSION)
print()

-- Two well-separated blobs in 2D, plus a couple of stragglers.
local data = {
  { 1.0, 1.0 },
  { 1.5, 2.0 },
  { 1.3, 1.4 },
  { 8.0, 8.0 },
  { 9.0, 8.5 },
  { 8.5, 9.0 },
}

-- helper: print a 1-based assignment array compactly
local function showAssignments(label, assignments)
  local parts = {}
  for i = 1, #assignments do
    parts[i] = tostring(assignments[i])
  end
  print(label, "[" .. table.concat(parts, ", ") .. "]")
end

-- 1) k-means (k-means++ seeding under the hood) -----------------------------
print("--- k-means (k = 2) ---")
local km = clustering.kmeans(data, 2, { delta = 0.0001, maxIter = 100, seed = 1 })
showAssignments("assignments:", km.assignments)
print("iterations: ", km.iterations)
for i = 1, #km.centroids do
  local c = km.centroids[i]
  print(string.format("  centroid %d: (%.3f, %.3f)", i, c[1], c[2]))
end
print()

-- 2) DBSCAN (density based; discovers cluster count, flags noise as 0) -------
print("--- DBSCAN (eps = 2.0, minPts = 2) ---")
local labels = clustering.dbscan(data, 2.0, 2)
showAssignments("labels:     ", labels)
print("(0 = noise)")
print()

-- 3) Hierarchical / agglomerative -------------------------------------------
print("--- hierarchical (k = 2, complete linkage) ---")
local hier = clustering.hierarchical(data, 2, { linkage = "complete" })
showAssignments("labels:     ", hier)
print()

-- 4) Mean shift (bandwidth controls the resulting cluster count) ------------
print("--- mean shift (bandwidth = 3.0) ---")
local ms = clustering.meanshift(data, 3.0, { maxIter = 100 })
showAssignments("assignments:", ms.assignments)
print("discovered clusters:", #ms.centroids)
for i = 1, #ms.centroids do
  local c = ms.centroids[i]
  print(string.format("  mode %d: (%.3f, %.3f)", i, c[1], c[2]))
end
