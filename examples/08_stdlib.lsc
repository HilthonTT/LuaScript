--!nocheck
-- Native stdlib demo.
--
-- The loader (vm/loader.go) reads `LUASCRIPT_LIB` exactly once at VM
-- startup and appends these rules to `package.path`:
--
--     $LUASCRIPT_LIB/?.lsc
--     $LUASCRIPT_LIB/?.lua
--     $LUASCRIPT_LIB/?/init.lsc
--     $LUASCRIPT_LIB/?/init.lua
--
-- So pointing LUASCRIPT_LIB at `examples/stdlib/` lets `require` find:
--
--     strings           -> examples/stdlib/strings.lsc
--     collections       -> examples/stdlib/collections/init.lsc
--     collections.list  -> examples/stdlib/collections/list.lsc
--
-- This module set lives under examples/stdlib/ rather than next to this
-- file, so the automatic script-directory entry can't reach it — that is
-- the point: LUASCRIPT_LIB is how you point `require` at a bundled library
-- root. Run from the project root (the `main` package lives in ./cmd):
--
--   bash:  LUASCRIPT_LIB=./examples/stdlib go run ./cmd ./examples/08_stdlib.lsc
--   pwsh:  $env:LUASCRIPT_LIB="./examples/stdlib"; go run ./cmd ./examples/08_stdlib.lsc
--   cmd:   set LUASCRIPT_LIB=./examples/stdlib && go run ./cmd ./examples/08_stdlib.lsc
--
-- With an installed `luascript` binary, drop the `go run ./cmd` and just run:
--   LUASCRIPT_LIB=./examples/stdlib ./luascript ./examples/08_stdlib.lsc
--
-- For convenience, the block below also makes this demo runnable WITHOUT
-- LUASCRIPT_LIB by deriving the stdlib path from the script-directory
-- entry that the loader already adds to package.path. Setting
-- LUASCRIPT_LIB still works (and the entries it appends are visible in
-- the final package.path printout); this just removes the env-var as a
-- hard prerequisite so `go run ./cmd examples/08_stdlib.lsc` just works.

for entry in package.path:gmatch("[^;]+") do
    local dir = entry:match("^(.+)/%?%.lsc$")
    if dir and not dir:match("^%.") then
        package.path = dir .. "/stdlib/?.lsc;"
                    .. dir .. "/stdlib/?/init.lsc;"
                    .. package.path
        break
    end
end

-- 1. Flat module at the stdlib root.
local strings = require("strings")
print("trim         = [" .. strings.trim("   hello world   ") .. "]")
print("starts_with  =", strings.starts_with("luascript", "lua"))

local parts = strings.split("a,b,,c", ",")
io.write("split        = ")
for i = 1, #parts do io.write("'", parts[i], "' ") end
print()

-- 2. Submodule via dotted name.
local List = require("collections.list")
local xs = List.new({ 1, 2, 3, 4 })
xs:push(5)
print("list         =", xs:tostr())
print("popped       =", xs:pop())
print("doubled      =", xs:map(function(x) return x * 2 end):tostr())

-- 3. Package init: `require "collections"` runs collections/init.lsc,
-- which re-exports the submodule so callers don't need a second require.
local collections = require("collections")
local ys = collections.list.new({ "a", "b", "c" })
print("via init     =", ys:tostr())

-- 4. Confirm the bundled-lib entries are actually on the path.
print()
print("package.path =")
local entries = strings.split(package.path, ";")
for i = 1, #entries do
    print("  " .. entries[i])
end
