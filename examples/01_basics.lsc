-- luascript basics: values, variables, operators, control flow.
--
--   go run ./cmd/luascript examples/01_basics.lsc
--
-- The language is Lua 5.4 with Luau-style gradual types bolted on. Nothing
-- in this file is typed, and that is fine: annotations are optional and an
-- un-annotated slot is `any`. Start with 05_types.lsc when you want them.

print("=== values ===")
-- Eight types, of which you will use five constantly.
print("nil      :", type(nil))
print("boolean  :", type(true))
print("number   :", type(42))
print("string   :", type("hi"))
print("table    :", type({}))
print("function :", type(print))
print("thread   :", type(coroutine.create(function() end)))
print()

print("=== integers and floats are both numbers ===")
-- Lua 5.4 keeps a real integer subtype. `math.type` tells them apart, and
-- the distinction shows up in division and in how values print.
print("3        ->", 3, math.type(3))
print("3.0      ->", 3.0, math.type(3.0))
print("3 == 3.0 ->", 3 == 3.0)          -- true: same value, different subtype
print("7 / 2    ->", 7 / 2, math.type(7 / 2))    -- / ALWAYS produces a float
print("7 // 2   ->", 7 // 2, math.type(7 // 2))  -- floor division stays integer
print("7 % 2    ->", 7 % 2)
print("2 ^ 10   ->", 2 ^ 10, math.type(2 ^ 10))  -- ^ also always floats
print()

print("=== variables and scope ===")
-- `local` is block-scoped and is what you want essentially always. A name
-- without `local` is a global, visible everywhere and easy to typo.
local greeting = "hello"
local count = 3
do
    local greeting = "shadowed"       -- a new binding, gone at `end`
    print("inside the block :", greeting)
end
print("outside the block:", greeting)

-- Multiple assignment. Extra targets get nil, extra values are discarded.
local a, b, c = 1, 2
print("a, b, c =", a, b, c)
a, b = b, a                           -- swap: the right side evaluates first
print("swapped =", a, b)
print()

print("=== strings ===")
print("concat    :", greeting .. " " .. "world")
print("length    :", #greeting)
print("upper     :", greeting:upper())      -- strings have methods
print("format    :", string.format("%s has %d chars", greeting, #greeting))
print("sub       :", greeting:sub(1, 4))
-- Long strings span lines and ignore escapes — handy for embedded text.
local block = [[line one
line two]]
print("long      :", block)
-- See 22_string_interpolation.lsc for `` `hi {name}` ``.
print()

print("=== truthiness ===")
-- ONLY nil and false are falsy. 0 and "" are both true — a frequent
-- surprise coming from C, Python or JavaScript.
local function truthy(v) return v and "truthy" or "falsy" end
print("nil    :", truthy(nil))
print("false  :", truthy(false))
print("0      :", truthy(0))       -- truthy!
print('""     :', truthy(""))      -- truthy!
print("{}     :", truthy({}))
print()

print("=== logical operators short-circuit ===")
-- `and`/`or` return one of their OPERANDS, not a boolean. That is what
-- makes the `or` idiom work as a default.
print("nil or 'fallback'   :", nil or "fallback")
print("'set' or 'fallback' :", "set" or "fallback")
print("nil and error()     :", nil and "never evaluated")
local config = nil
local port = config and config.port or 8080
print("port with default   :", port)
-- The trap: `x and y or z` breaks when y is false or nil, because the
-- `and` then yields a falsy value and `or` moves on to z.
print("true and false or 'z':", true and false or "z")   -- "z", not false
print()

print("=== conditionals ===")
local emphatic = true
if emphatic then
    print(greeting .. "!")
elseif count > 0 then
    print(greeting)
else
    print("(silence)")
end
-- There is also an if EXPRESSION — see 50_if_expressions.lsc.
local mood = if emphatic then "loud" else "quiet"
print("mood:", mood)
print()

print("=== numeric for ===")
local total = 0
for i = 1, count do
    total = total + i
end
print("sum 1.." .. count .. " =", total)

-- With a step, including a negative one.
io.write("countdown:")
for i = 5, 1, -1 do
    io.write(" ", i)
end
print()

-- Float bounds work too. The loop variable is local to the loop and
-- assigning to it does not affect iteration.
io.write("halves   :")
for x = 0, 1, 0.25 do
    io.write(" ", x)
end
print()
print()

print("=== generic for ===")
-- `pairs` walks every key in unspecified order; `ipairs` walks 1..n and
-- stops at the first hole. Prefer ipairs for arrays.
local primes = { 2, 3, 5, 7, 11 }
io.write("ipairs:")
for i, p in ipairs(primes) do
    io.write(" ", i, "=", p)
end
print()

local ages = { ada = 36, grace = 45 }
for name, age in pairs(ages) do
    print("  " .. name .. " is " .. age)
end
print()

print("=== while, repeat, break ===")
local n = 10
while n > 0 do
    if n == 5 then break end
    n = n - 1
end
print("while stopped at:", n)

-- `repeat` always runs its body once, and the `until` condition can see
-- locals declared inside the body.
local tries = 0
repeat
    tries = tries + 1
    local done = tries >= 3
until done
print("repeat ran:", tries, "times")

-- `continue` skips to the next iteration — see 49_continue.lsc.
io.write("odd numbers:")
for i = 1, 8 do
    if i % 2 == 0 then continue end
    io.write(" ", i)
end
print()
print()

print("=== comparison and equality ===")
print("1 == 1.0     :", 1 == 1.0)      -- numbers compare by value
print("'a' < 'b'    :", "a" < "b")     -- strings compare lexicographically
print("{} == {}     :", {} == {})      -- tables compare by IDENTITY
local t = {}
print("t == t       :", t == t)
print("1 == '1'     :", 1 == "1")      -- no coercion across types
print("1 ~= 2       :", 1 ~= 2)        -- `~=` is Lua's "not equal"
print()

print("=== next steps ===")
print("  02_functions.lsc            closures, multi-return, varargs")
print("  03_tables_and_metatables    records, arrays, operator overloading")
print("  05_types.lsc                gradual types")
print("  08_stdlib.lsc               the standard library")
