--!nocheck
-- The `sort` module: in-place array sorting via classic algorithms.
local sort = require("sort")

print("=== Sort Module Test ===")
print("VERSION:", sort.VERSION)
print()

-- Small helper to render arrays inline since we don't have one built in.
local function show(arr)
    local out = "{"
    for i = 1, #arr do
        if i > 1 then out = out .. ", " end
        out = out .. tostring(arr[i])
    end
    return out .. "}"
end

-- quicksort on integers.
local ints = { 3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5 }
print("ints before    :", show(ints))
sort.quicksort(ints)
print("ints quicksort :", show(ints))
print()

-- bubble on strings (lexicographic).
local words = { "banana", "apple", "cherry", "date" }
print("words before   :", show(words))
sort.bubble(words)
print("words bubble   :", show(words))
print()

-- circle on floats.
local floats = { 2.5, -1.0, 3.14, 0.0, -0.5 }
print("floats before  :", show(floats))
sort.circle(floats)
print("floats circle  :", show(floats))
print()

-- simple on a mixed int/float array. The module promotes ints to
-- float64 so a single total order applies.
local mixed = { 1, 2.5, 0, -1.5, 3 }
print("mixed before   :", show(mixed))
sort.simple(mixed)
print("mixed simple   :", show(mixed))
print()

-- The return value is the same table — sort is in place, matching
-- Lua's table.sort. So you can also write:
local chained = sort.quicksort({ 9, 7, 8, 6, 5 })
print("chained        :", show(chained))
print()

-- Edge cases.
local empty = {}
sort.quicksort(empty)
print("empty          :", show(empty))

local single = { 42 }
sort.bubble(single)
print("single         :", show(single))

-- Already sorted — should be a no-op cost-wise but still works.
local sorted = { 1, 2, 3, 4, 5 }
sort.circle(sorted)
print("already sorted :", show(sorted))

-- Reverse sorted — worst case for some algorithms.
local reverse = { 5, 4, 3, 2, 1 }
sort.quicksort(reverse)
print("reverse        :", show(reverse))
print()

-- Comparing the four algorithms on the same input proves they
-- all converge on the same answer.
print("--- algorithm consistency check ---")
local input = { 7, 2, 9, 1, 5, 3, 8, 4, 6 }
print("input          :", show(input))

local function copy(arr)
    local out = {}
    for i = 1, #arr do out[i] = arr[i] end
    return out
end

print("quicksort      :", show(sort.quicksort(copy(input))))
print("bubble         :", show(sort.bubble(copy(input))))
print("circle         :", show(sort.circle(copy(input))))
print("simple         :", show(sort.simple(copy(input))))
print()

-- --- comparator-driven entries (added 2026-06-04) ---
-- sort.sort(t [, cmp]) is the entry most user code reaches for. With no
-- cmp it sorts ascending using the per-type dispatch; with a cmp it
-- invokes the predicate for every comparison.
print("--- sort.sort with comparator ---")
local desc = sort.sort({ 5, 2, 8, 1, 9, 3 }, function(a, b) return a > b end)
print("descending     :", show(desc))

-- Sorting by a derived key — comparator computes whatever ordering you
-- want. Here: by string length, then alphabetically as a tiebreaker.
local words2 = { "fig", "apple", "kiwi", "blueberry", "pear" }
sort.sort(words2, function(a, b)
    if #a ~= #b then return #a < #b end
    return a < b
end)
print("by length      :", show(words2))

-- sort.stable preserves the original order of equal-by-comparator
-- elements. With a custom cmp that only looks at the first field, the
-- second field's original order is preserved.
print("--- sort.stable ---")
local pairs_t = { {"b", 2}, {"a", 1}, {"a", 2}, {"b", 1}, {"c", 3} }
sort.stable(pairs_t, function(x, y) return x[1] < y[1] end)
local rendered = ""
for i = 1, #pairs_t do
    if i > 1 then rendered = rendered .. ", " end
    rendered = rendered .. "(" .. pairs_t[i][1] .. "," .. pairs_t[i][2] .. ")"
end
print("by first field :", rendered)

-- sort.reverse flips the array in-place. Useful after a default sort to
-- get a descending list without paying for a custom comparator.
print("--- sort.reverse ---")
local flip = { 1, 2, 3, 4, 5 }
sort.reverse(flip)
print("reversed       :", show(flip))

-- sort.is_sorted is the read-only counterpart. Same comparator shape.
print("--- sort.is_sorted ---")
print("ascending sorted :", sort.is_sorted({ 1, 2, 3, 4 }))           -- true
print("descending check :", sort.is_sorted({ 4, 3, 2, 1 }))           -- false (no cmp)
print("descending+cmp   :", sort.is_sorted({ 4, 3, 2, 1 }, function(a, b) return a > b end)) -- true
print("unsorted         :", sort.is_sorted({ 1, 3, 2, 4 }))           -- false