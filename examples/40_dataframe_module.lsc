--!nocheck
-- DataFrame native module: a column-oriented, pandas-style table. Every
-- transforming method returns a NEW DataFrame, so chains never mutate the
-- original. print(df) renders an aligned preview via __tostring.
local dataframe = require("dataframe")

print("=== DataFrame Module ===")
print("VERSION:", dataframe.VERSION)
print()

-- 1) Build from columns -----------------------------------------------------
local df = dataframe.new({
  name   = { "Ada", "Grace", "Linus", "Margaret", "Dennis" },
  dept   = { "eng", "eng", "eng", "sci", "sci" },
  salary = { 120, 140, 95, 110, 130 },
  age    = { 36, 40, 28, 45, 33 },
})

print("--- full frame ---")
print(df)
local r, c = df:shape()
print(string.format("shape: %d rows x %d cols", r, c))
print()

-- 2) Inspect ----------------------------------------------------------------
print("--- head(3) ---")
print(df:head(3))
print()

-- 3) Select / derive / filter / sort (chained, non-mutating) ----------------
print("--- engineers earning > 100, with a bonus column, sorted desc ---")
local top = df
  :filter(function(row) return row.dept == "eng" and row.salary > 100 end)
  :with_column("bonus", function(row) return row.salary * 0.1 end)
  :select({ "name", "salary", "bonus" })
  :sort("salary", true)
print(top)
print()

-- 4) Group-by aggregation ---------------------------------------------------
print("--- mean salary and head-count per department ---")
local grouped = df:group_by("dept", { salary = "mean", age = "max", name = "count" })
print(grouped)
print()

-- 5) Summary statistics -----------------------------------------------------
print("--- describe (numeric columns only) ---")
print(df:describe())
print()

-- 6) Interop: to CSV text ---------------------------------------------------
print("--- to_csv ---")
io.write(df:select({ "name", "salary" }):to_csv())

print("=== other ways to build a frame ===")
-- dataframe.new takes COLUMNS. Data often arrives as ROWS instead — a
-- query result, a JSON array of objects — and from_rows takes those
-- directly, reading the column names off the keys.
local rows = {
    { name = "ada", dept = "eng", salary = 120 },
    { name = "grace", dept = "eng", salary = 130 },
    { name = "alan", dept = "research", salary = 110 },
}
local from_rows = dataframe.from_rows(rows)
print(from_rows)
print("columns:", table.concat(from_rows:columns(), ", "))
print()

-- from_csv reads a file, using the header line for the column names.
print("=== from_csv ===")
local path = os.tmpname()
local f = io.open(path, "w")
f:write("city,population,country\n")
f:write("Oslo,709000,Norway\n")
f:write("Bergen,286000,Norway\n")
f:write("Tromso,77000,Norway\n")
f:close()

local cities = dataframe.from_csv(path)
print(cities)
print("shape:", cities:shape())

-- Numeric-looking columns come back as NUMBERS, not strings, so they are
-- ready to compute with straight away.
local pops = cities:col("population")
local total = 0
for _, v in ipairs(pops) do total = total + v end
print("first value type:", type(pops[1]))
print("total population:", total)
os.remove(path)
print()

print("=== round trip ===")
-- to_csv writes the same format back out, so a frame survives a trip
-- through a file unchanged.
local out = os.tmpname()
cities:to_csv(out)
local reread = dataframe.from_csv(out)
print("re-read shape:", reread:shape())
print("same columns :", table.concat(reread:columns(), ", "))
os.remove(out)
